{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://auth.sistemafacturacion.local",
    "Audience": "https://api.sistemafacturacion.local",
    "PublicKeyPath": "keys/public.pem"
  },
  "ReverseProxy": {
    "Routes": {
      "ruta-auth": {
        "ClusterId": "cluster-auth",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "ruta-clientes": {
        "ClusterId": "cluster-billing",
        "AuthorizationPolicy": "RequiereToken",
        "Match": {
          "Path": "/api/clientes/{**catch-all}"
        }
      },
      "ruta-productos": {
        "ClusterId": "cluster-billing",
        "AuthorizationPolicy": "RequiereToken",
        "Match": {
          "Path": "/api/productos/{**catch-all}"
        }
      },
      "ruta-facturas": {
        "ClusterId": "cluster-billing",
        "AuthorizationPolicy": "RequiereToken",
        "Match": {
          "Path": "/api/facturas/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "cluster-auth": {
        "Destinations": {
          "auth-1": {
            "Address": "http://localhost:5169/"
          }
        }
      },
      "cluster-billing": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "Destinations": {
          "billing-1": {
            "Address": "http://localhost:5062/"
          }
        }
      }
    }
  }
}